# -------------------------------------------------------------------
# Airflow
# -------------------------------------------------------------------

AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_API_AUTH_JWT_SECRET=replace-with-random-secret

AIRFLOW_DB_PASSWORD=change-me

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me


# -------------------------------------------------------------------
# CRM PostgreSQL
# -------------------------------------------------------------------

CRM_DB_PASSWORD=change-me


# -------------------------------------------------------------------
# Telemetry PostgreSQL
# -------------------------------------------------------------------

TELEMETRY_DB_PASSWORD=change-me


# -------------------------------------------------------------------
# ClickHouse
#
# CLICKHOUSE_HTTP_PORT — порт, публикуемый Docker Compose на хост.
# CLICKHOUSE_PORT — порт, используемый локально запущенным
# bionicpro-reports.
# -------------------------------------------------------------------

CLICKHOUSE_HTTP_PORT=18123

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_DATABASE=reports_olap
CLICKHOUSE_USERNAME=reports
CLICKHOUSE_PASSWORD=change-me


# -------------------------------------------------------------------
# bionicpro-auth database
# -------------------------------------------------------------------

AUTH_DB_HOST=localhost
AUTH_DB_PORT=5434
AUTH_DB_NAME=bionicpro_auth
AUTH_DB_USERNAME=bionicpro_auth
AUTH_DB_PASSWORD=change-me


# -------------------------------------------------------------------
# Redis session storage
# -------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me


# -------------------------------------------------------------------
# Keycloak
# -------------------------------------------------------------------

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

KEYCLOAK_DB_PASSWORD=change-me

KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/reports-realm
KEYCLOAK_CLIENT_ID=bionicpro-auth
KEYCLOAK_CLIENT_SECRET=change-me


# -------------------------------------------------------------------
# bionicpro-auth application settings
# -------------------------------------------------------------------

REPORTS_SERVICE_URL=http://localhost:8082
FRONTEND_URL=http://localhost:3000


# -------------------------------------------------------------------
# Yandex ID
#
# Для фактического входа через Яндекс необходимо указать параметры
# собственного OAuth-приложения.
# -------------------------------------------------------------------

YANDEX_CLIENT_ID=change-me
YANDEX_CLIENT_SECRET=change-me


# -------------------------------------------------------------------
# LDAP
# -------------------------------------------------------------------

LDAP_ADMIN_PASSWORD=change-me
LDAP_CONFIG_PASSWORD=change-me

# Должен соответствовать паролю bind-пользователя LDAP.
LDAP_BIND_CREDENTIAL=change-me


# -------------------------------------------------------------------
# MinIO / S3
#
# MINIO_ACCESS_KEY и MINIO_SECRET_KEY должны соответствовать
# учётным данным, созданным в MinIO.
# Для локального варианта можно использовать значения root user.
# -------------------------------------------------------------------

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

MINIO_BUCKET=bionicpro-reports
MINIO_REGION=us-east-1

MINIO_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me


# -------------------------------------------------------------------
# Report CDN and object keys
# -------------------------------------------------------------------

REPORT_CDN_BASE_URL=http://localhost:3000/cdn
REPORT_OBJECT_KEY_SECRET=replace-with-random-secret


# -------------------------------------------------------------------
# Kafka and Debezium
# -------------------------------------------------------------------

KAFKA_CLUSTER_ID=replace-with-valid-kafka-cluster-id

CRM_CDC_USERNAME=bionicpro_debezium
CRM_CDC_PASSWORD=change-me
