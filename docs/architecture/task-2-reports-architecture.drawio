<mxfile host="app.diagrams.net" modified="2026-06-26T06:00:00.000Z" agent="ChatGPT" version="24.8.4" type="device">
  <diagram id="bionicpro-reports" name="To-Be — сервис отчётов и ETL">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="user" value="&lt;b&gt;Пользователь протеза&lt;/b&gt;&lt;br&gt;[Person]" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#6C6477;strokeColor=#4D4D4D;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="190" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="frontend" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;[Container: React]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Выбор периода и получение собственного отчёта&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="520" width="250" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="system-boundary" value="&lt;b&gt;BionicPRO&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="70" width="1700" height="1280" as="geometry"/>
        </mxCell>

        <mxCell id="online-boundary" value="&lt;b&gt;Online-контур выдачи отчётов&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="130" width="760" height="520" as="geometry"/>
        </mxCell>

        <mxCell id="etl-boundary" value="&lt;b&gt;ETL / аналитический контур&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="700" width="1580" height="580" as="geometry"/>
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;bionicpro-auth&lt;/b&gt;&lt;br&gt;[Container: Spring Boot BFF]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Проверяет сессию и передаёт access token только во внутренний контур&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="730" y="300" width="280" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="reports" value="&lt;b&gt;bionicpro-reports&lt;/b&gt;&lt;br&gt;[Container: Spring Boot]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /reports?from&amp;to. Берёт user subject из JWT и возвращает только собственный отчёт&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="300" width="290" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;[Container: Identity Provider]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Публичные ключи JWT / роли / subject пользователя&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="500" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="crm" value="&lt;b&gt;CRM DB&lt;/b&gt;&lt;br&gt;[External System: PostgreSQL]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Клиенты, связь user subject → customer → prosthesis&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="840" width="260" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="telemetry" value="&lt;b&gt;Telemetry DB&lt;/b&gt;&lt;br&gt;[External System: PostgreSQL]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Сырые события датчиков по device_id и event_time&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="1050" width="260" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="airflow" value="&lt;b&gt;Apache Airflow&lt;/b&gt;&lt;br&gt;[Container: Scheduler + DAG]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Почасовой ETL: extract → stage → transform → publish → watermark&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="900" width="290" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="olap" value="&lt;b&gt;OLAP DB&lt;/b&gt;&lt;br&gt;[Container: ClickHouse]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;staging-таблицы, дневная витрина user_report_daily и ETL watermark&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1490" y="900" width="300" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="mart" value="&lt;b&gt;Витрина user_report_daily&lt;/b&gt;&lt;br&gt;[Table]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ключ: (user_subject, report_date). Предагрегированные показатели телеметрии + атрибуты CRM&lt;/font&gt;" style="shape=table;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1860" y="865" width="300" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="watermark" value="&lt;b&gt;ETL watermark&lt;/b&gt;&lt;br&gt;[Table]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;processed_until — верхняя граница периода, доступного пользователю&lt;/font&gt;" style="shape=table;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1860" y="1080" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e-user-frontend" value="Выбирает период и запрашивает отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-frontend-auth" value="HTTPS + server-side session cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="frontend" target="auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-auth-reports" value="Внутренний HTTP + Bearer access token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="auth" target="reports">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-reports-keycloak" value="Проверяет подпись JWT по JWKS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="reports" target="keycloak">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-reports-olap" value="SELECT только готовых агрегатов по token.sub и периоду" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="reports" target="olap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-crm-airflow" value="Extract CRM инкрементально" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="crm" target="airflow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-telemetry-airflow" value="Extract telemetry по data interval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="telemetry" target="airflow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-airflow-olap" value="Load staging, join, aggregate, publish идемпотентно" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="airflow" target="olap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-olap-mart" value="Формирует/обновляет дневную витрину" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="olap" target="mart">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-olap-watermark" value="Обновляет только после успешной публикации" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="olap" target="watermark">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-watermark-reports" value="Проверка: requested_to ≤ processed_until; иначе 409" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="watermark" target="reports">
